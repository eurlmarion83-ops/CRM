# Copiez ce fichier en .env puis ajustez les valeurs.

# PostgreSQL — en local : voir README (docker ou installation locale) ; en production :
# Vercel Postgres / Neon / Supabase fournissent cette variable automatiquement.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medcrm"

# NextAuth — générez votre propre secret : `openssl rand -base64 32`
AUTH_SECRET="changeme-generate-your-own-secret"
NEXTAUTH_URL="http://localhost:3000"

# Fournisseurs SMS/Email — laisser vide en dev : les envois sont mockés (voir src/lib/notifications.ts).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
RESEND_API_KEY=""
EMAIL_FROM="no-reply@example-cabinet.fr"

# Téléconsultation (Jitsi Meet) — meet.jit.si en démo uniquement (NON conforme HDS).
# En production, pointer vers une instance Jitsi auto-hébergée certifiée HDS ou un
# fournisseur JaaS/LiveKit/Daily contractualisé HDS (voir README §Conformité).
NEXT_PUBLIC_JITSI_DOMAIN="meet.jit.si"

# Secret partagé pour protéger /api/cron/reminders (optionnel en dev)
CRON_SECRET=""

# Secret pour déclencher /api/setup/seed-demo à distance (génère le jeu de données de
# démonstration sans accès local à la base). Générez une valeur aléatoire, ex : openssl rand -hex 16
SEED_SECRET=""

# Annuaire national des professionnels de santé (RPPS/ADELI, Annuaire Santé - ANS).
# Laisser vide : la recherche reste limitée aux praticiens inscrits sur la plateforme.
# Voir src/lib/directory.ts pour le point d'intégration réel (non implémenté par défaut :
# aucune fausse donnée de praticien n'est générée dans ce projet).
ANNUAIRE_SANTE_API_KEY=""

# Paiement en ligne (téléconsultation) — laisser vide : le paiement est simulé via une page
# interne (/paiement/mock/...). Voir src/lib/payments.ts.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
